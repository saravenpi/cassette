{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cassette",
  "version": "0.17.2",
  "identifier": "dev.saravenpi.cassette",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cassette",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "backgroundColor": "#0B0B0B",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGNUI3NTcxQjAxQzYyMjgKUldRb1loeXdjWFZiRCtad3JKVncrOGpIU1pxQXZPOTlEVzJkMk5UTXZYYnFsMjBjSjkveHlzU1UK",
      "endpoints": [
        "https://github.com/Saravenpi/cassette/releases/latest/download/latest.json"
      ]
    }
  }
}
